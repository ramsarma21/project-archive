# ---- API / server ----
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
# Read by nothing. Kept only because removing a name from this file is how the
# next author concludes it was never meant to exist; WEB_ORIGIN below is the one
# the API actually enforces CORS and OAuth redirects against.
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# ---- Database (docker compose maps container 5432 -> host 55432) ----
DATABASE_URL=postgres://project_archive:project_archive@localhost:55432/project_archive
TEST_DATABASE_URL=postgres://project_archive:project_archive@localhost:55432/project_archive_test
# ECS uses discrete DB_* values injected by CDK/Secrets Manager instead.
DB_HOST=
DB_PORT=5432
DB_NAME=project_archive
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# ---- Session / cookies ----
# Read by @pa/grading, which derives the duel-verdict receipt key from it by
# HKDF under a separate info label whenever GRADING_RECEIPT_SECRET is unset.
SESSION_SECRET=dev-only-change-me-32-bytes-minimum-secret
# The duel-verdict receipt key: one key with one job, rotatable on its own
# schedule, and preferred over deriving from SESSION_SECRET.
#
# Deployed tasks take this from Secrets Manager (project-archive/verdict-receipt,
# key `receiptSecret`) — see infra/README.md for the create-secret command. Leave
# it blank locally and the HKDF derivation from SESSION_SECRET above covers you;
# a rotation on the deployed stack does not need a change here.
GRADING_RECEIPT_SECRET=
CSRF_SECRET=dev-only-change-me-separate-csrf-secret
# Local development only. Deployed stacks take this from CDK, which defaults to
# secure and refuses an insecure opt-out for any non-localhost origin.
COOKIE_SECURE=false

# ---- Google OAuth (fill these in; see §5 of Localhost-Text-Slice-Spec.md) ----
# In Google Cloud console, register this EXACT redirect URI (goes through the Vite proxy):
#   http://localhost:5173/v1/auth/google/callback
# and this JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/v1/auth/google/callback

# ---- Web client ----
# Set to the deployed HTTPS API URL to run Vite against AWS.
VITE_API_PROXY_TARGET=
VITE_ENABLE_DEBUG_PANEL=true
# QA affordance only. The owner-provided production CP1 bank is installed and
# all three macros are production-eligible, so the student path serves the real
# bank with this false. Set true only to force the QA draft fixtures; the
# runtime otherwise rejects draft fixtures in production.
VITE_CP1_ALLOW_DRAFT_BANK=false
# Explicit QA/dev opt-in for AUTHOR_DRAFT/HISTORICAL_REVIEW_PENDING content.
# Production must remain false until historical, curriculum, and calibration gates pass.
VITE_OPEN_RESPONSE_AUTHOR_DRAFT=false

# ---- Answer grading (@pa/grading) ----
# NEVER reuse the image-generation credential below. That is not tidiness: the
# gateway serialises — 622ms median serially, 1516ms at concurrency 3 against a
# 1.5-second cap — so a class of thirty sharing a key with an asset render sits
# on the cap and every round takes the generous fallback, which grants a full
# magazine for any answer. Grading needs a TrueFoundry key with its OWN quota.
#
# Deployed tasks take this from Secrets Manager
# (project-archive/grading-credential, key `apiKey`). Local development may fall
# back to TRUEFOUNDRY_API_KEY below; production never does.
TRUEFOUNDRY_GRADING_API_KEY=
TRUEFOUNDRY_GRADING_BASE_URL=https://tfy.promptlens.trilogy.com/v1
# Chosen by measurement. The previous value here,
# aws-bedrock/us.amazon.nova-micro-v1-0, was replaced ON EVIDENCE: it measured a
# 15% FALSE-NEGATIVE rate — correct answers marked wrong — including a student
# whose only error was writing 1863 for 1763, which is exactly the slip the
# official scoring guide credits. A false negative is the toxic direction, so no
# amount of cheapness buys it back. Flash Lite passes at 98.7% with 0.7% false
# negatives and is also the fastest of the five candidates measured.
# Re-benchmark with `pnpm grading:eval --model ...` before changing this.
TRUEFOUNDRY_GRADING_MODEL=gemini-group/gemini-3.5-flash-lite
TRUEFOUNDRY_GRADING_STRUCTURED_OUTPUT=true
# Percentage of duel rounds granted-without-grading, per rolling window, past
# which the API says so at error level in its own logs. The deployed stack also
# alarms on the same rate through CloudWatch; this is the half a person watching
# a lesson can see. 0 disables the log escalation, never the counting.
GRADING_FALLBACK_ALERT_PERCENT=25
# AUDIT counts unsigned duel verdicts at the mission commit and lets them
# through; REQUIRE refuses the commit. An INVALID receipt is refused under both
# settings — see apps/api/src/duels/commitReceipts.ts.
#
# THE OLD CONDITION FOR FLIPPING THIS IS NOW MET AND IT IS STILL NOT ENOUGH. The
# web client does carry x-pa-verdict-receipt into its commit log, and a graded
# round now commits `verified`, measured end to end against a running API. But an
# ABSENT receipt is not only an old client: the client's 1.5-second cap, an
# unreachable API and the stand-in authority all produce a verdict no server
# minted, and the design GRANTS the maximum on all three so that infrastructure
# never costs a student anything. Under REQUIRE that same round returns 409 and
# takes the mission clear instead — confirmed live, one unreachable round out of
# two. Flipping needs a way to refuse a stripped receipt without refusing an
# honestly ungraded round, and the log cannot tell them apart today because the
# only thing that would distinguish them is client-supplied.
DUEL_RECEIPT_ENFORCEMENT=AUDIT
#
# The 1.5-second grading deadline, the retry budget, the circuit breaker and the
# verdict cache are constants in packages/grading/src/tuning.ts, not variables:
# they are Mission-Slate numbers rather than deployment settings. The
# GRADING_ENABLED / GRADING_MAX_CONCURRENCY / GRADING_REQUESTS_PER_MINUTE /
# GRADING_DAILY_TOKEN_LIMIT / TRUEFOUNDRY_GRADING_TIMEOUT_MS /
# GRADING_ENCRYPTION_KEY_* variables this file used to document belonged to the
# deleted formative grader and are read by nothing; they are gone from here and
# from the ECS task definition rather than left to imply that setting
# GRADING_ENABLED=false turns grading off. It does not — a credential does.

# ---- Asset pipeline keys ----
# Meshy: text/image -> 3D generation (assets/pipeline/gen_*.mjs)
MESHY_API_KEY=
# ElevenLabs: voice (future audio pass)
ELEVENLABS_API_KEY=

# ---- Concept art generation (TrueFoundry gateway -> Gemini image) ----
# assets/pipeline/gen_concept_image.mjs generates 1765-Boston concept/reference
# sheets (street layouts, facades, interiors, props) with Nano Banana Pro, which
# feed the Meshy image-to-3D pipeline. The base URL is the OpenAI-compatible
# TrueFoundry gateway root (it exposes /images/generations and /images/edits).
TRUEFOUNDRY_API_KEY=
TRUEFOUNDRY_BASE_URL=https://tfy.promptlens.trilogy.com/v1
NANO_BANANA_MODEL=gemini-group/gemini-3-pro-image-preview
