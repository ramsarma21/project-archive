only-built-dependencies[]=esbuild
verify-deps-before-run=false
# Related to the `thread-stream` override in package.json: that package was
# published with a stray `.claude/settings.local.json` inside its tarball, and
# the agent sandbox denies writes to any `.claude` path. Materialising it fails
# with EPERM and aborts the install *after* node_modules has been emptied, which
# presents as a hang rather than a failure. 4.1.0 is the same minor without the
# stray file; drop the override once upstream republishes.
package-import-method=hardlink
