__pycache__/
*.pyc
sim/.state/

# node
node_modules/
dist/
build/
*.tsbuildinfo

# env & secrets
.env
.env.local
.local/keys/

# content build output
content/**/compiled/

# ---- runtime world assets: admitted, not allow-listed --------------------
#
# apps/web/public/world is what the browser loads, and it is admitted by
# default. This used to be inverted: the directory was denied and each approved
# asset was re-admitted with its own `!` line, which meant a newly generated
# asset was silently excluded until a human remembered to add one. Nothing
# catches that omission - a missing GLB renders nothing, no test fails, and the
# world simply has a hole in it. 88 assets, including 13 of the 15 rigged
# characters, had accumulated behind that pattern.
#
# So the default is now the safe direction: forgetting a rule costs repository
# size, which is visible and reversible, instead of costing an invisible hole.
# The pipeline stages sources and intermediates under assets/ (denied below) and
# syncs only finished, approved assets here, so the denials that follow are
# guards against accidents rather than part of the routine.

# Authoring sources and interchange formats never belong in the served tree.
apps/web/public/world/**/*.blend
apps/web/public/world/**/*.blend[0-9]
apps/web/public/world/**/*.fbx
apps/web/public/world/**/*.obj
apps/web/public/world/**/*.mtl
apps/web/public/world/**/*.abc
apps/web/public/world/**/*.psd
apps/web/public/world/**/*.tif
apps/web/public/world/**/*.tiff
apps/web/public/world/**/*.exr
apps/web/public/world/**/*.zip

# Intermediates and experiments, by the pipeline's naming conventions.
apps/web/public/world/**/*-raw.glb
apps/web/public/world/**/*-unoptimized.glb
apps/web/public/world/**/*-wip.glb
apps/web/public/world/**/*-draft.glb
apps/web/public/world/**/*-test.glb
apps/web/public/world/**/*-experiment*.glb
apps/web/public/world/**/*.tmp.*
apps/web/public/world/**/tmp/
apps/web/public/world/**/scratch/

# Pipeline working trees: generated or third-party sources, rebuilt by the
# assets/pipeline scripts and never served to the browser.
assets/build/
assets/source/characters/
assets/source/mixamo/

# logs
*.log
npm-debug.log*
**/cdk.out/

# build / QA artifacts (wave0a: keep out of the repo)
test-results/
.pnpm-store/
apps/web/dist*/

.install*.log
.nm-trash-*

.api.log
.web.log
.t.log
.tc.log
.build.log

.pw-browsers/
.shots/

# ---- pipeline intermediates: provenance kept, payloads not ----------------
#
# The served tree above is admitted by default because a missing GLB is an
# invisible hole. These are the opposite case: raw generator output and concept
# plates are large, reproducible from the prompts beside them, and never loaded
# by the browser. So the small JSON that records how an asset was made stays,
# and the megabytes it produced do not.
assets/source/raw/**/*.glb
assets/source/raw/**/*.fbx
assets/source/raw/**/*.obj
assets/source/raw/**/*.zip
assets/source/concepts/**/*.png
assets/source/concepts/**/*.jpg
assets/source/concepts/**/*.jpeg

# OS and editor droppings
.DS_Store
**/.DS_Store

# stray probe files agents leave behind
**/tsconfig.tmp.json
apps/api/.diag-*.mts

# Worker scratch space: probes, screenshots, one-off diagnostics. Hundreds of
# untracked files that clutter every `git status` and have already been swept
# into a commit by accident. Never loaded by anything; local to a worker.
.affordwork/
.cursor/locks/
