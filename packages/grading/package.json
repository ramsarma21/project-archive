{
  "name": "@pa/grading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "grading:eval": "node --import tsx src/eval/cli.ts",
    "grading:pipeline": "node --import tsx src/pipeline/cli.ts",
    "grading:bench": "node --import tsx src/liveBenchmark.ts"
  },
  "dependencies": {
    "@pa/duel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
